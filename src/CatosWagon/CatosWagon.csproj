<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CatosWagon</AssemblyName>
    <RootNamespace>CatosWagon</RootNamespace>
    <Version>1.0.0</Version>
    <OutputPath>bin/Release/net48/</OutputPath>
    <GeneratePathProperty>true</GeneratePathProperty>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="../../../Households-REPO/lib/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="../../../Households-REPO/lib/BepInEx/core/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="../../../Households-REPO/lib/BepInEx/core/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="../../../Households-REPO/lib/BepInEx/core/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="../../../Households-REPO/lib/BepInEx/core/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="../../../Households-REPO/lib/BepInEx/core/assembly_utils.dll" Private="false" />
    <Reference Include="Jotunn" HintPath="../../../Households-REPO/lib/BepInEx/core/Jotunn.dll" Private="false" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Wagon\catoswagon_market_wagons" />
    <EmbeddedResource Include="Assets\icon.png" />
  </ItemGroup>
</Project>
